# Två olika slumpvärden, minst 32 tecken vardera.
MCP_API_KEY=
DOWNLOAD_SECRET=
# Lokal testning. Byt till https://DITT-PROJEKT.vercel.app i Vercel.
PUBLIC_BASE_URL=http://localhost:3000
# local används endast lokalt. Sätt blob i Vercel.
STORAGE_DRIVER=local
# Koppla ett PRIVATE Vercel Blob-lager och ange dess token.
BLOB_READ_WRITE_TOKEN=
# Länkar gäller en timme. Dokument kan därefter tas bort med cleanup.
DOWNLOAD_TTL_SECONDS=3600
